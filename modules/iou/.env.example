# Optional ignored app overrides; tracked public defaults live in ../../publishing/.env.local.
# Process environment values take precedence. Standalone copies need local/exported settings.
# Use only a public Supabase publishable/anon key, never a secret or service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: /repository-name/ for a GitHub project site, / for a custom domain.
# Leaving this empty uses relative asset URLs for local previews.
VITE_BASE_PATH=
